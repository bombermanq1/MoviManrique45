// COMPATIBILIDAD: este archivo conserva el conjunto compacto previo.
// Para la implementación completa use dax/medidas_modelo.dax, que incorpora
// validación exacta de los 604 IDs, medidas de calidad y temporales.

Registros = COUNTROWS(FactSiniestros)

Registros corredor =
CALCULATE([Registros], REMOVEFILTERS(DimClasificacion), DimClasificacion[categoria_analisis] = "principal_50m")

Registros sensibilidad =
CALCULATE([Registros], REMOVEFILTERS(DimClasificacion), DimClasificacion[categoria_analisis] = "sensibilidad_borde")

Registros revision territorial =
CALCULATE([Registros], REMOVEFILTERS(DimClasificacion), DimClasificacion[categoria_analisis] = "revision_territorial")

Comuna 3 comparable =
CALCULATE([Registros], REMOVEFILTERS(DimClasificacion), REMOVEFILTERS(DimTerritorioNominal), REMOVEFILTERS(DimTerritorioGeometrico), REMOVEFILTERS(DimZona), REMOVEFILTERS(DimSegmento))

Corredor comparable =
CALCULATE([Registros corredor], REMOVEFILTERS(DimTerritorioNominal), REMOVEFILTERS(DimTerritorioGeometrico), REMOVEFILTERS(DimZona), REMOVEFILTERS(DimSegmento))

Porcentaje corredor sobre Comuna 3 = DIVIDE([Corredor comparable], [Comuna 3 comparable])

Mediana distancia corredor m =
CALCULATE(MEDIAN(FactSiniestros[distancia_carrera45_m]), REMOVEFILTERS(DimClasificacion), DimClasificacion[categoria_analisis] = "principal_50m")

Registros sin zona = CALCULATE([Registros], REMOVEFILTERS(DimZona), DimZona[zona_id] = "SIN_ZONA")
